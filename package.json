{
  "name": "havhabit",
  "version": "1.0.0",
  "description": "Build better habits with smart tracking. Enjoy real-time success scores, streak tracking, weekly goals, habit categories, motivational quotes, and simple analytics. Track progress from “Just Beginning” to “Elite Performer.” Switch between dark/light themes and stay secure with easy user authentication.",
  "main": "auth.js",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "build:mobile": "mkdir -p www && cp *.html *.css *.js www/ || true",
    "sync": "npm run build:mobile && npx cap sync",
    "open:ios": "npx cap open ios",
    "open:android": "npx cap open android",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
